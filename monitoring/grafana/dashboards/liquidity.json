{
  "uid": "blockpulse-liquidity",
  "title": "BlockPulse Liquidity",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Pool Events", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (pool_id, event_type) (rate(blockpulse_pool_events_total[15m]))", "legendFormat": "{{pool_id}} {{event_type}}", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "Collection Cycles", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "rate(blockpulse_collection_cycles_total[15m])", "legendFormat": "cycles", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Collection Duration", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, rate(blockpulse_collection_duration_seconds_bucket[15m]))", "legendFormat": "p95 duration", "refId": "A"}]}
  ]
}
