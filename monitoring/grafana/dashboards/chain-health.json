{
  "uid": "blockpulse-chain-health",
  "title": "BlockPulse Chain Health",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Health Severity", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "blockpulse_chain_health_status", "legendFormat": "chain {{chain_id}}", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "RPC Observations", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum by (chain_id, success) (rate(blockpulse_rpc_observations_total[5m]))", "legendFormat": "chain {{chain_id}} success={{success}}", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Endpoint API Latency", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(blockpulse_http_request_duration_seconds_bucket[5m])))", "legendFormat": "HTTP p95", "refId": "A"}]}
  ]
}
