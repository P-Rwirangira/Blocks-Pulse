{
  "uid": "blockpulse-overview",
  "title": "BlockPulse Overview",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "stat", "title": "HTTP Requests (5m)", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "sum(increase(blockpulse_http_requests_total[5m]))", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Binance Collection Failures", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "increase(blockpulse_binance_collection_failures_total[5m])", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Binance Candles", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "sum by (symbol, interval) (rate(blockpulse_binance_klines_total[5m]))", "legendFormat": "{{symbol}} {{interval}}", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "Anomalies by Severity", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "sum by (severity) (rate(blockpulse_anomalies_total[15m]))", "legendFormat": "{{severity}}", "refId": "A"}]}
  ]
}
